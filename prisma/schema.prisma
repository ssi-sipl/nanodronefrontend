generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Area {
  id       String   @id @default(cuid()) 
  name     String
  area_id  String   @unique
  drones   Drone[]
}

model Drone {
  id         String   @id @default(cuid())
  name       String
  drone_id   String   @unique
  area_id    String
  areaRef    String   
  cameraFeed String?  @default("rtsp://<user>:<admin>@<ip>:554/{stream url}")
  area       Area?    @relation(fields: [areaRef], references: [id])
  usbaddress String?
}

model Sensor {
  id         String  @id @default(cuid())
  name       String
  area_id    String
  sensor_id  String  @unique
  latitude   Float
  longitude  Float
  cameraFeed String?
}

model User {
  id        String  @id @default(cuid())
  email     String  @unique
  password  String
}

model OfflineMap {
  id              String    @id @default(cuid())
  name            String   @unique
  description     String?
  north           Float
  south           Float
  east            Float
  west            Float
  minZoom         Int
  maxZoom         Int
  totalTiles      Int
  downloadedTiles Int      @default(0)
  failedTiles     Int      @default(0)
  status          String   @default("downloading")
  folderPath      String
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())
}
